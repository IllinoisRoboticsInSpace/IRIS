#!/usr/bin/python3
# EASY-INSTALL-ENTRY-SCRIPT: 'controls','console_scripts','controller_node'
__requires__ = 'controls'
import re
import sys
from pkg_resources import load_entry_point

if __name__ == '__main__':
    sys.argv[0] = re.sub(r'(-script\.pyw?|\.exe)?$', '', sys.argv[0])
    sys.exit(
        load_entry_point('controls', 'console_scripts', 'controller_node')()
    )
